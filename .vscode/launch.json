{
  // ra_tick attach (direct): build + `cargo run -p ra_tick`, then attach by executable or PID.
  // Subprocess: `cargo build -p ra_tick -p ra_tick_launcher` then `cargo run -p ra_tick_launcher`
  // — attach to the **child** PID printed (still use "Attach to ra_tick (by executable)" on the child).
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "LLDB: integration test (ra_sandbox)",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "-p",
          "ra_sandbox",
          "--test=integration"
        ],
        "cwd": "${workspaceFolder}/ra-workspace-demo",
        "filter": {
          "name": "integration",
          "kind": "test"
        }
      },
      "args": [
        "cross_crate_public_api",
        "--exact",
        "--nocapture"
      ],
      "cwd": "${workspaceFolder}/ra-workspace-demo",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "LLDB: integration test (full feature)",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "-p",
          "ra_sandbox",
          "--test=integration",
          "--features",
          "full"
        ],
        "cwd": "${workspaceFolder}/ra-workspace-demo",
        "filter": {
          "name": "integration",
          "kind": "test"
        }
      },
      "args": [
        "full_feature_chain",
        "--exact",
        "--nocapture"
      ],
      "cwd": "${workspaceFolder}/ra-workspace-demo",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "LLDB: ra_sandbox binary",
      "cargo": {
        "args": ["build", "-p", "ra_sandbox"],
        "cwd": "${workspaceFolder}/ra-workspace-demo",
        "filter": {
          "name": "ra_sandbox",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}/ra-workspace-demo",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "attach",
      "name": "LLDB: Attach to ra_tick (by executable)",
      "windows": {
        "program": "${workspaceFolder}/ra-workspace-demo/target/debug/ra_tick.exe"
      },
      "linux": {
        "program": "${workspaceFolder}/ra-workspace-demo/target/debug/ra_tick"
      },
      "osx": {
        "program": "${workspaceFolder}/ra-workspace-demo/target/debug/ra_tick"
      },
      "cwd": "${workspaceFolder}/ra-workspace-demo",
      "sourceLanguages": ["rust"]
    },
    {
      "type": "lldb",
      "request": "attach",
      "name": "LLDB: Attach to ra_tick (by PID)",
      "pid": "${input:raTickPid}",
      "sourceLanguages": ["rust"]
    }
  ],
  "inputs": [
    {
      "id": "raTickPid",
      "type": "promptString",
      "description": "PID printed by ra_tick at startup (or from Task Manager)",
      "default": ""
    }
  ]
}
